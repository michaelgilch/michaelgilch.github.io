---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>['data'];
}
const { project } = Astro.props;
const { image } = project;
---

<article class="card">
  <div class:list={['card__main', { 'card__main--img': image }]}>
    {image && <Image class="card__img" src={image} alt="" width={256} />}
    <h3 class="card__title">{project.name}</h3>
    <p class="card__desc">{project.description}</p>
  </div>

  {
    project.tech.length > 0 && (
      <ul class="card__tech">
        {project.tech.map((t) => (
          <li class="tag">{t}</li>
        ))}
      </ul>
    )
  }

  <div class="card__links">
    {
      project.repo && (
        <a href={project.repo} rel="noopener">
          Code →
        </a>
      )
    }
    {
      project.demo && (
        <a href={project.demo} rel="noopener">
          Live →
        </a>
      )
    }
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-6);
    transition: border-color 0.15s ease, transform 0.15s ease;
    container: card / inline-size;
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-border));
    transform: translateY(-2px);
  }
  /* Title + description. The 1fr row lets the description absorb extra
     height so tags and links sit at the bottom of equal-height cards. */
  .card__main {
    flex-grow: 1;
    display: grid;
    grid-template-rows: auto 1fr;
    row-gap: var(--space-2);
  }
  /* Narrow card: small image beside the title, description full width. */
  .card__main--img {
    grid-template-columns: 64px 1fr;
    grid-template-areas:
      'img title'
      'desc desc';
    column-gap: var(--space-4);
  }
  .card__main--img .card__img {
    grid-area: img;
    align-self: start;
  }
  .card__main--img .card__title {
    grid-area: title;
    align-self: center;
  }
  .card__main--img .card__desc {
    grid-area: desc;
  }
  /* Wide card: larger image spanning title and description. 21rem of
     content leaves the text ~190px beside a 128px image. */
  @container card (min-width: 21rem) {
    .card__main--img {
      grid-template-columns: 128px 1fr;
      grid-template-areas:
        'img title'
        'img desc';
    }
    .card__main--img .card__title {
      align-self: start;
    }
  }
  .card__img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    /* Non-square sources crop instead of stretching. */
    object-fit: cover;
    border-radius: calc(var(--radius) * 0.75);
    border: 1px solid var(--color-border);
  }
  .card__title {
    margin: 0;
  }
  .card__desc {
    color: var(--color-muted);
    font-size: 0.98rem;
  }
  .card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: var(--space-2) 0 var(--space-4);
    padding: 0;
  }
  .card__links {
    display: flex;
    gap: var(--space-6);
    font-weight: 550;
    font-size: 0.95rem;
  }
</style>
