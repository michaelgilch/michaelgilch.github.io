---
// Photo grid with a click-to-enlarge lightbox.
//
// Use once per page: the client script below is hoisted and bundled by Astro,
// so it runs a single time no matter how many instances render. It collects
// links from every grid on the page and drives the first dialog it finds.
//
// Don't write a literal script tag in this comment — the compiler scans the raw
// file for one and would treat everything after it as script source.
//
// Without JavaScript each photo is still a plain link to its full-size image,
// so the wall degrades to something usable rather than something inert.
import { Image, getImage } from 'astro:assets';
import type { Photo } from '../data/photos';

interface Props {
  photos: Photo[];
  /** 'wall' is the roomy /photos layout; 'strip' is the tighter homepage row. */
  variant?: 'wall' | 'strip';
}

const { photos, variant = 'wall' } = Astro.props;

// One optimized large render per photo, used as both the lightbox source and
// the no-JS link target. Capped at the source width so smaller photos aren't
// upscaled into mush.
const items = await Promise.all(
  photos.map(async (photo) => ({
    photo,
    full: await getImage({
      src: photo.src,
      width: Math.min(2000, photo.src.width),
      format: 'webp',
    }),
  })),
);

// How wide a tile actually renders, per viewport band. These track the column
// counts the auto-fill grid below settles into (page chrome eats ~8rem, and a
// column is at its widest just before another one fits).
//
// The bands deliberately round UP: over-declaring costs a few kB, while
// under-declaring makes the browser fetch a too-small file and shows as visible
// blur. If you retune --wide-width or the grid's minmax, recheck these.
const sizes =
  variant === 'strip'
    ? '(max-width: 40rem) calc(100vw - 8rem), (max-width: 56rem) calc(50vw - 4rem), (max-width: 78rem) calc(33vw - 2rem), 18rem'
    : '(max-width: 50rem) calc(100vw - 8rem), (max-width: 78rem) calc(50vw - 4rem), 23rem';
---

<ul class:list={['photo-grid', `photo-grid--${variant}`]} data-photo-grid>
  {
    items.map(({ photo, full }) => (
      <li class="photo">
        <figure class="photo__figure">
          <a
            class="photo__link"
            href={full.src}
            data-full={full.src}
            data-caption={photo.caption ?? ''}
            data-alt={photo.alt}
            aria-label={photo.alt ? undefined : 'View full-size photo'}
          >
            <Image
              class="photo__img"
              src={photo.src}
              alt={photo.alt}
              widths={[320, 480, 640, 960]}
              sizes={sizes}
            />
          </a>
          {photo.caption && <figcaption class="photo__caption">{photo.caption}</figcaption>}
        </figure>
      </li>
    ))
  }
</ul>

<dialog class="lightbox" data-lightbox aria-label="Photo viewer">
  <button class="lightbox__btn lightbox__close" data-lightbox-close aria-label="Close photo viewer">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>

  <button class="lightbox__btn lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="Previous photo">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M15 4L7 12l8 8" />
    </svg>
  </button>

  <div class="lightbox__inner">
    <img class="lightbox__img" data-lightbox-img src="" alt="" />
    <p class="lightbox__caption" data-lightbox-caption hidden></p>
  </div>

  <button class="lightbox__btn lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="Next photo">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 4l8 8-8 8" />
    </svg>
  </button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-photo-grid] .photo__link'),
  );

  if (dialog && links.length > 0) {
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const caption = dialog.querySelector<HTMLParagraphElement>('[data-lightbox-caption]')!;
    const prevBtn = dialog.querySelector<HTMLButtonElement>('[data-lightbox-prev]')!;
    const nextBtn = dialog.querySelector<HTMLButtonElement>('[data-lightbox-next]')!;
    const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]')!;

    let index = 0;
    let opener: HTMLElement | null = null;

    // A single photo has nowhere to page to, so drop the arrows entirely
    // rather than leaving two controls that only ever reload the same image.
    const single = links.length === 1;
    prevBtn.hidden = single;
    nextBtn.hidden = single;

    /** Warm the neighbours so paging doesn't stall on a fresh download. */
    function preload(i: number) {
      const url = links[(i + links.length) % links.length]?.dataset.full;
      if (url) new Image().src = url;
    }

    function show(i: number) {
      index = (i + links.length) % links.length;
      const link = links[index];
      const text = link.dataset.caption ?? '';

      img.src = link.dataset.full ?? '';
      img.alt = link.dataset.alt ?? '';
      caption.textContent = text;
      caption.hidden = text === '';

      if (!single) {
        preload(index + 1);
        preload(index - 1);
      }
    }

    links.forEach((link, i) => {
      link.addEventListener('click', (event) => {
        // Leave modified clicks alone so "open in new tab" still works.
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        opener = link;
        show(i);
        dialog.showModal();
      });
    });

    prevBtn.addEventListener('click', () => show(index - 1));
    nextBtn.addEventListener('click', () => show(index + 1));
    closeBtn.addEventListener('click', () => dialog.close());

    // Clicks that land on the dialog itself (the area around the photo) close
    // it; clicks on the image or buttons bubble from a child and are ignored.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (single) return;
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(index + 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(index - 1);
      }
    });

    // Escape closes natively; this covers every close path, including that one.
    // The viewer reuses one <img>, so each new photo replaces the previous
    // decode — there's nothing to clean up here beyond returning focus.
    dialog.addEventListener('close', () => {
      opener?.focus();
      opener = null;
    });
  }
</script>

<style>
  .photo-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }
  /* auto-fill (not auto-fit) keeps tracks a consistent width whatever the photo
     count, so a wall of three doesn't render as three enormous panels. */
  .photo-grid--wall {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
  .photo-grid--strip {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-4);
  }

  .photo__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .photo__link {
    display: block;
    border-radius: var(--radius);
    /* Contains the zoom on hover so the image can't spill past the corners. */
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .photo__link:hover {
    border-color: var(--color-accent);
  }

  .photo__img {
    display: block;
    width: 100%;
    height: auto;
    /* Uniform crop keeps the grid tidy across mixed orientations. The lightbox
       shows the whole frame, so nothing is lost, only deferred. */
    aspect-ratio: var(--photo-aspect);
    object-fit: cover;
    transition: transform 0.25s ease;
  }
  .photo__link:hover .photo__img {
    transform: scale(1.03);
  }

  .photo__caption {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .photo__img {
      transition: none;
    }
    .photo__link:hover .photo__img {
      transform: none;
    }
  }

  /* ---------------------------------------------------------------------------
     Lightbox
     ------------------------------------------------------------------------- */
  .lightbox {
    /* Override the UA's centred, bordered, size-capped default box: this dialog
       is the whole viewport, with the photo centred inside it. Explicit
       positioning also gives the close and nav buttons something to anchor to. */
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
    /* Centres .lightbox__inner and puts the nav arrows on either side. */
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
  }
  .lightbox[open] {
    display: flex;
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.85);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .lightbox__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: min(90rem, 100%);
    /* Room for the caption under the photo without pushing it off screen. */
    padding-block: var(--space-6);
  }

  .lightbox__img {
    display: block;
    max-width: 100%;
    max-height: 78vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .lightbox__caption {
    margin: 0;
    max-width: var(--measure);
    text-align: center;
    font-size: 0.95rem;
    line-height: 1.5;
    /* Fixed light treatment: this sits on the dark backdrop in both themes. */
    color: #eceff4;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.6);
  }

  .lightbox__btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.45);
    color: #eceff4;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .lightbox__btn:hover {
    background: rgb(0 0 0 / 0.75);
    border-color: var(--color-accent);
  }
  .lightbox__btn svg {
    width: 1.35rem;
    height: 1.35rem;
    display: block;
  }
  .lightbox__btn[hidden] {
    display: none;
  }

  .lightbox__close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 1;
  }

  /* Phones: arrows move off the sides and sit under the photo, where a thumb
     can reach them, and the close button shrinks out of the way. */
  @media (max-width: 40rem) {
    .lightbox {
      gap: var(--space-2);
      padding-inline: var(--space-2);
    }
    .lightbox__nav {
      position: absolute;
      bottom: var(--space-6);
      z-index: 1;
    }
    .lightbox__nav--prev {
      left: var(--space-6);
    }
    .lightbox__nav--next {
      right: var(--space-6);
    }
    .lightbox__inner {
      padding-bottom: var(--space-16);
    }
    .lightbox__img {
      max-height: 62vh;
    }
  }
</style>
